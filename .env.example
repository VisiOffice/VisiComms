# Copy to .env for Docker Compose. Supply your own Resend key and webhook secret.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Enable receiving for this domain in Resend, including its MX record.
INBOUND_EMAIL_DOMAIN=in.example.com
# Must match the browser origin; use your public HTTPS origin in production.
APP_URL=http://localhost:8081
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:8081
# For a new production database, set a strong URL-safe password.
POSTGRES_PASSWORD=

# Optional SMS through an existing SignalWire project.
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SIGNING_KEY=
# Public HTTPS origin receiving /webhooks/signalwire/sms and /status.
SIGNALWIRE_PUBLIC_URL=
