# Secrets for config/deploy.yml. Copy to .kamal/secrets (ignored by git) and
# point each line at your password manager. Never put raw values in a file
# that is committed. This example uses the 1Password CLI; any command that
# prints the value works. `op read` fails on a missing item, which stops the
# deploy instead of shipping a blank secret.
OP="op://<vault>/<item>"

KAMAL_REGISTRY_PASSWORD=$(op read "$OP/KAMAL_REGISTRY_PASSWORD")
POSTGRES_PASSWORD=$(op read "$OP/POSTGRES_PASSWORD")
INBOUND_EMAIL_SECRET=$(op read "$OP/INBOUND_EMAIL_SECRET")
AWS_SES_ACCESS_KEY_ID=$(op read "$OP/AWS_SES_ACCESS_KEY_ID")
AWS_SES_SECRET_ACCESS_KEY=$(op read "$OP/AWS_SES_SECRET_ACCESS_KEY")
SES_EVENTS_TOPIC_ARN=$(op read "$OP/SES_EVENTS_TOPIC_ARN")
# Seals each workspace's data key, which seals its connector credentials
# (internal/secrets). Losing it means re-entering every workspace's credentials.
VISICOMMS_MASTER_KEY=$(op read "$OP/VISICOMMS_MASTER_KEY")
# AI call answering; leave these three empty to keep it off.
OPENAI_API_KEY=$(op read "$OP/OPENAI_API_KEY")
OPENAI_PROJECT_ID=$(op read "$OP/OPENAI_PROJECT_ID")
OPENAI_WEBHOOK_SECRET=$(op read "$OP/OPENAI_WEBHOOK_SECRET")
# Call recordings: an S3-compatible key limited to the recordings bucket.
RECORDINGS_S3_KEY_ID=$(op read "$OP/RECORDINGS_S3_KEY_ID")
RECORDINGS_S3_SECRET=$(op read "$OP/RECORDINGS_S3_SECRET")

# The db accessory is reachable from the app container as visicomms-db.
DATABASE_URL=postgres://visicomms:${POSTGRES_PASSWORD}@visicomms-db:5432/visicomms?sslmode=disable
# The backup accessory (docs/backups.md): the same database password, a key
# limited to the backup bucket, and an optional missed-backup heartbeat URL.
PGPASSWORD=${POSTGRES_PASSWORD}
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=$(op read "$OP/B2_BACKUP_KEY_ID")
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=$(op read "$OP/B2_BACKUP_APPLICATION_KEY")
HEARTBEAT_URL=
